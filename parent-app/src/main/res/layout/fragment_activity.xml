<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <com.google.android.material.tabs.TabLayout android:id="@+id/tab_layout_activity" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tv_activity_date" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageButton android:id="@+id/btn_prev_day" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="Previous day" android:src="@drawable/ic_arrow_back" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/btn_next_day" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="Next day" android:src="@drawable/ic_arrow_forward" />
    </LinearLayout>
    <com.github.mikephil.charting.charts.PieChart android:id="@+id/pie_chart_apps" android:layout_width="match_parent" android:layout_height="220dp" />
    <TextView android:id="@+id/tv_total_screen_time" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_app_usage_detail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_call_logs" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
    <TextView android:id="@+id/tv_call_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_sms_logs" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
    <TextView android:id="@+id/tv_sms_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
</LinearLayout>
