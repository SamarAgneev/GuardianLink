<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
    <View android:id="@+id/view_severity_bar" android:layout_width="6dp" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/tv_alert_title" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv_alert_message" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv_alert_time" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv_alert_severity" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
    <Button android:id="@+id/btn_resolve_alert" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resolve" />
</LinearLayout>
