<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/tv_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" />
    <TextView android:id="@+id/tv_coordinates" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" />
    <TextView android:id="@+id/tv_accuracy" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" />
    <TextView android:id="@+id/tv_speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btn_location_history" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="History" />
        <Button android:id="@+id/btn_add_geofence" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Add geofence" />
    </LinearLayout>
</LinearLayout>
