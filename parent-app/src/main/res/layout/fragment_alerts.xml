<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <Button android:id="@+id/btn_mark_all_read" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mark all read" />
    <TextView android:id="@+id/tv_alerts_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No alerts" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_alerts" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
